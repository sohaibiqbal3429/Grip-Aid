# Public site URL used for canonical URLs, Open Graph, sitemap, and robots output.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery settings.
CONTACT_TO_EMAIL=contact@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM="Automec Platform <no-reply@example.com>"

# MongoDB settings.
# Do not commit real credentials in this file. Copy this file to .env.local locally
# and replace the placeholders with the production or development connection details.
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.rw9p5pe.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB=automec
MONGODB_DATABASE=automec
MONGODB_USER=<username>
MONGODB_PASS=<password>
MONGODB_HOST=<cluster-host>

# Newsletter subscription provider settings. The endpoint should accept a POST
# body with { "email": string, "listId": string, "source": string }.
NEWSLETTER_API_URL=https://api.example-email-provider.com/newsletter/subscriptions
NEWSLETTER_API_KEY=newsletter-api-key
NEWSLETTER_LIST_ID=newsletter-list-id
